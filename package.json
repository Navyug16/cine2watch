{
  "name": "movie-decision-tool",
  "version": "1.0.0",
  "description": "CineMatch Studio - Intelligent Cinema & Web Series Decision Engine",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,VITE\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "start": "concurrently -n \"API,VITE\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix backend run start",
    "client": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.6",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
